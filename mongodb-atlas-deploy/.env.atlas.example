# Copy values into Backend/.env on your server
PORT=5000

# Paste Atlas connection string (Drivers → Node.js)
# Replace USERNAME, PASSWORD, and cluster host
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.xxxxx.mongodb.net/rugos?retryWrites=true&w=majority

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend URL (Netlify / your domain) — used for CORS
CLIENT_URL=https://your-frontend-domain.com
